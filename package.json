{
  "name": "git-log-plus",
  "displayName": "Git Log Plus — Commit, Log & History",
  "description": "A full IDE-style Git workflow for VS Code and Cursor: commit tool window with partial commits, commit graph log, interactive rebase, push dialog, annotate, and editable diffs.",
  "version": "0.3.0",
  "publisher": "daliuchen",
  "license": "MIT",
  "icon": "media/git-log.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/daliuchen/git-log-plus.git"
  },
  "homepage": "https://github.com/daliuchen/git-log-plus#readme",
  "bugs": {
    "url": "https://github.com/daliuchen/git-log-plus/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "git log",
    "commit graph",
    "history",
    "commit",
    "partial commit",
    "interactive rebase",
    "blame",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitLogWorkbench.openLog",
    "onCommand:gitLogWorkbench.commit.open",
    "onCommand:gitLogWorkbench.editor.showLineHistory",
    "onCommand:gitLogWorkbench.editor.showSelectionHistory",
    "onCommand:gitLogWorkbench.editor.showFileHistory",
    "onCommand:gitLogWorkbench.explorer.showFolderHistory",
    "onCommand:gitLogWorkbench.editor.compareFileWithRef",
    "onView:gitLogWorkbench.log",
    "onView:gitLogWorkbench.commit",
    "onCommand:gitLogWorkbench.push",
    "onCommand:gitLogWorkbench.updateProject",
    "onCommand:gitLogWorkbench.editor.toggleAnnotate",
    "onCommand:gitLogWorkbench.branches",
    "onCommand:gitLogWorkbench.editor.commitChange",
    "onCommand:gitLogWorkbench.editor.amendChange"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitLogWorkbench.openLog",
        "title": "Open Log",
        "category": "Git Log",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitLogWorkbench.commit.open",
        "title": "Commit…",
        "category": "Git Log",
        "icon": "$(check)"
      },
      {
        "command": "gitLogWorkbench.editor.showLineHistory",
        "title": "Show History for Current Line",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.editor.showSelectionHistory",
        "title": "Show History for Selection",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.editor.showFileHistory",
        "title": "Show File History",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.explorer.showFolderHistory",
        "title": "Show Folder History",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.editor.compareFileWithRef",
        "title": "Compare File with Branch or Tag…",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.diff.jumpToSource",
        "title": "Jump to Source",
        "category": "Git Log",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitLogWorkbench.push",
        "title": "Push…",
        "category": "Git Log",
        "icon": "$(repo-push)"
      },
      {
        "command": "gitLogWorkbench.updateProject",
        "title": "Update Project…",
        "category": "Git Log",
        "icon": "$(repo-pull)"
      },
      {
        "command": "gitLogWorkbench.editor.toggleAnnotate",
        "title": "Annotate with Git Blame",
        "category": "Git Log",
        "icon": "$(person)"
      },
      {
        "command": "gitLogWorkbench.branches",
        "title": "Branches…",
        "category": "Git Log",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitLogWorkbench.compareWithLocal",
        "title": "Compare Revision with Local",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.editor.commitChange",
        "title": "Commit This Change…",
        "category": "Git Log"
      },
      {
        "command": "gitLogWorkbench.editor.amendChange",
        "title": "Amend This Change into Last Commit",
        "category": "Git Log"
      }
    ],
    "submenus": [
      {
        "id": "gitLogWorkbench.editorContext",
        "label": "Git Log"
      },
      {
        "id": "gitLogWorkbench.explorerContext",
        "label": "Git Log"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "gitLogWorkbench.editorContext",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitLogWorkbench.explorerContext",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "gitLogWorkbench.explorerContext": [
        {
          "command": "gitLogWorkbench.editor.showFileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "1_history@1"
        },
        {
          "command": "gitLogWorkbench.explorer.showFolderHistory",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "1_history@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitLogWorkbench.explorer.showFolderHistory",
          "when": "false"
        },
        {
          "command": "gitLogWorkbench.diff.jumpToSource",
          "when": "resourceScheme == git-log-workbench"
        },
        {
          "command": "gitLogWorkbench.compareWithLocal",
          "when": "false"
        }
      ],
      "gitLogWorkbench.editorContext": [
        {
          "command": "gitLogWorkbench.editor.toggleAnnotate",
          "when": "resourceScheme == file",
          "group": "0_annotate@1"
        },
        {
          "command": "gitLogWorkbench.editor.commitChange",
          "when": "resourceScheme == file",
          "group": "0_annotate@2"
        },
        {
          "command": "gitLogWorkbench.editor.amendChange",
          "when": "resourceScheme == file",
          "group": "0_annotate@3"
        },
        {
          "command": "gitLogWorkbench.editor.showLineHistory",
          "when": "resourceScheme == file && !editorHasSelection",
          "group": "1_history@1"
        },
        {
          "command": "gitLogWorkbench.editor.showSelectionHistory",
          "when": "resourceScheme == file && editorHasSelection",
          "group": "1_history@1"
        },
        {
          "command": "gitLogWorkbench.editor.showFileHistory",
          "when": "resourceScheme == file",
          "group": "1_history@2"
        },
        {
          "command": "gitLogWorkbench.editor.compareFileWithRef",
          "when": "resourceScheme == file",
          "group": "2_compare@1"
        }
      ],
      "editor/title": [
        {
          "command": "gitLogWorkbench.diff.jumpToSource",
          "when": "resourceScheme == git-log-workbench",
          "group": "navigation@1"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "gitLogWorkbench.editor.toggleAnnotate",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        },
        {
          "command": "gitLogWorkbench.editor.commitChange",
          "when": "resourceScheme == file",
          "group": "navigation@101"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "gitLogWorkbench",
          "title": "Git Log",
          "icon": "media/git-log.png"
        }
      ],
      "activitybar": [
        {
          "id": "gitLogCommit",
          "title": "Commit",
          "icon": "media/commit.svg"
        }
      ]
    },
    "views": {
      "gitLogWorkbench": [
        {
          "id": "gitLogWorkbench.log",
          "name": "Git Log",
          "type": "webview"
        }
      ],
      "gitLogCommit": [
        {
          "id": "gitLogWorkbench.commit",
          "name": "Commit",
          "type": "webview",
          "icon": "media/commit.svg"
        }
      ]
    },
    "configuration": {
      "title": "Git Log",
      "properties": {
        "gitLogWorkbench.git.path": {
          "type": "string",
          "default": "git",
          "description": "Path to the Git executable."
        },
        "gitLogWorkbench.currentLineBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show author, relative time, and commit information after the active editor line. Uncommitted edit times are tracked from document changes and retained in workspace state. Automatically suppressed while VS Code's built-in Git blame editor decoration is enabled."
        },
        "gitLogWorkbench.lineHistory.contextLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 20,
          "description": "Number of unchanged lines shown above and below changes in current-line history. The tracked Git history remains limited to the current line."
        },
        "gitLogWorkbench.repositories.scanDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 8,
          "description": "Maximum directory depth used when discovering nested repositories."
        },
        "gitLogWorkbench.repositories.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.worktrees/**"
          ],
          "description": "Glob patterns excluded from repository discovery."
        },
        "gitLogWorkbench.log.initialPageSize": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 2000
        },
        "gitLogWorkbench.log.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 20,
          "maximum": 5000
        },
        "gitLogWorkbench.performance.maxCachedCommits": {
          "type": "number",
          "default": 5000,
          "minimum": 200,
          "maximum": 50000
        },
        "gitLogWorkbench.performance.maxDiffFileBytes": {
          "type": "number",
          "default": 5242880,
          "minimum": 1024,
          "maximum": 104857600,
          "description": "Maximum historical file size opened in the built-in text diff editor."
        },
        "gitLogWorkbench.debug.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "debug"
          ],
          "default": "off"
        }
      }
    },
    "keybindings": [
      {
        "command": "gitLogWorkbench.diff.jumpToSource",
        "key": "f4",
        "when": "editorTextFocus && resourceScheme == git-log-workbench"
      }
    ]
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "npm run build && node ./scripts/run-integration.mjs",
    "test:performance": "vitest run test/performance",
    "package": "npm run clean && npm run build && vsce package --no-dependencies --baseContentUrl https://github.com/daliuchen/git-log-plus/blob/main --baseImagesUrl https://raw.githubusercontent.com/daliuchen/git-log-plus/main"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
