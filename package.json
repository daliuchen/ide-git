{
  "name": "ide-git",
  "displayName": "IDE Git — IntelliJ-style Commit, Log & Rebase",
  "description": "The IntelliJ-style Git tool for Cursor and VS Code: a commit window with chunk- and line-level commits, branch comparison and cherry-pick, interactive rebase, a push dialog, and editable diffs.",
  "version": "0.9.0",
  "publisher": "EthanLiuChen",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "icon": "media/git-log.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/daliuchen/ide-git.git"
  },
  "homepage": "https://github.com/daliuchen/ide-git#readme",
  "bugs": {
    "url": "https://github.com/daliuchen/ide-git/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "git log",
    "intellij",
    "ide",
    "commit graph",
    "history",
    "commit",
    "partial commit",
    "interactive rebase",
    "blame",
    "cursor"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitLogWorkbench.openLog",
    "onCommand:gitLogWorkbench.commit.open",
    "onCommand:gitLogWorkbench.editor.showLineHistory",
    "onCommand:gitLogWorkbench.editor.showSelectionHistory",
    "onCommand:gitLogWorkbench.editor.showFileHistory",
    "onCommand:gitLogWorkbench.explorer.showFolderHistory",
    "onCommand:gitLogWorkbench.editor.compareFileWithRef",
    "onView:gitLogWorkbench.log",
    "onView:gitLogWorkbench.commit",
    "onCommand:gitLogWorkbench.push",
    "onCommand:gitLogWorkbench.updateProject",
    "onCommand:gitLogWorkbench.editor.toggleAnnotate",
    "onCommand:gitLogWorkbench.showCommitInLog",
    "onCommand:gitLogWorkbench.branches",
    "onCommand:gitLogWorkbench.editor.commitChange",
    "onCommand:gitLogWorkbench.editor.amendChange"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gitLogWorkbench.openLog",
        "title": "Open Log",
        "category": "IDE Git",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitLogWorkbench.commit.open",
        "title": "Commit…",
        "category": "IDE Git",
        "icon": "$(check)"
      },
      {
        "command": "gitLogWorkbench.editor.showLineHistory",
        "title": "Show History for Current Line",
        "category": "IDE Git"
      },
      {
        "command": "gitLogWorkbench.editor.showSelectionHistory",
        "title": "Show History for Selection",
        "category": "IDE Git"
      },
      {
        "command": "gitLogWorkbench.editor.showFileHistory",
        "title": "Show File History",
        "category": "IDE Git"
      },
      {
        "command": "gitLogWorkbench.explorer.showFolderHistory",
        "title": "Show Folder History",
        "category": "IDE Git"
      },
      {
        "command": "gitLogWorkbench.editor.compareFileWithRef",
        "title": "Compare File with Branch or Tag…",
        "category": "IDE Git"
      },
      {
        "command": "gitLogWorkbench.diff.jumpToSource",
        "title": "Jump to Source",
        "category": "IDE Git",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitLogWorkbench.diff.nextChange",
        "title": "Next Difference (continues into the next file)",
        "category": "IDE Git"
      },
      {
        "command": "gitLogWorkbench.diff.previousChange",
        "title": "Previous Difference (continues into the previous file)",
        "category": "IDE Git"
      },
      {
        "command": "gitLogWorkbench.push",
        "title": "Push…",
        "category": "IDE Git",
        "icon": "$(repo-push)"
      },
      {
        "command": "gitLogWorkbench.updateProject",
        "title": "Update Project…",
        "category": "IDE Git",
        "icon": "$(repo-pull)"
      },
      {
        "command": "gitLogWorkbench.showCommitInLog",
        "title": "Show Commit in Git Log",
        "category": "IDE Git"
      },
      {
        "command": "gitLogWorkbench.editor.toggleAnnotate",
        "title": "Annotate with Git Blame",
        "category": "IDE Git",
        "icon": "$(person)"
      },
      {
        "command": "gitLogWorkbench.branches",
        "title": "Branches…",
        "category": "IDE Git",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitLogWorkbench.compareWithLocal",
        "title": "Compare Revision with Local",
        "category": "IDE Git"
      },
      {
        "command": "gitLogWorkbench.editor.commitChange",
        "title": "Commit This Change…",
        "category": "IDE Git"
      },
      {
        "command": "gitLogWorkbench.editor.amendChange",
        "title": "Amend This Change into Last Commit",
        "category": "IDE Git"
      }
    ],
    "submenus": [
      {
        "id": "gitLogWorkbench.editorContext",
        "label": "IDE Git"
      },
      {
        "id": "gitLogWorkbench.explorerContext",
        "label": "IDE Git"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "gitLogWorkbench.editorContext",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitLogWorkbench.explorerContext",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ],
      "gitLogWorkbench.explorerContext": [
        {
          "command": "gitLogWorkbench.editor.showFileHistory",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "1_history@1"
        },
        {
          "command": "gitLogWorkbench.explorer.showFolderHistory",
          "when": "resourceScheme == file && explorerResourceIsFolder",
          "group": "1_history@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitLogWorkbench.diff.nextChange",
          "when": "textCompareEditorVisible"
        },
        {
          "command": "gitLogWorkbench.diff.previousChange",
          "when": "textCompareEditorVisible"
        },
        {
          "command": "gitLogWorkbench.explorer.showFolderHistory",
          "when": "false"
        },
        {
          "command": "gitLogWorkbench.diff.jumpToSource",
          "when": "resourceScheme == git-log-workbench"
        },
        {
          "command": "gitLogWorkbench.compareWithLocal",
          "when": "false"
        }
      ],
      "gitLogWorkbench.editorContext": [
        {
          "command": "gitLogWorkbench.editor.toggleAnnotate",
          "when": "resourceScheme == file || resourceScheme == git-log-workbench",
          "group": "0_annotate@1"
        },
        {
          "command": "gitLogWorkbench.showCommitInLog",
          "when": "resourceScheme == file && !editorHasSelection",
          "group": "0_annotate@2"
        },
        {
          "command": "gitLogWorkbench.editor.commitChange",
          "when": "resourceScheme == file",
          "group": "0_annotate@3"
        },
        {
          "command": "gitLogWorkbench.editor.amendChange",
          "when": "resourceScheme == file",
          "group": "0_annotate@4"
        },
        {
          "command": "gitLogWorkbench.editor.showLineHistory",
          "when": "resourceScheme == file && !editorHasSelection",
          "group": "1_history@1"
        },
        {
          "command": "gitLogWorkbench.editor.showSelectionHistory",
          "when": "resourceScheme == file && editorHasSelection",
          "group": "1_history@1"
        },
        {
          "command": "gitLogWorkbench.editor.showFileHistory",
          "when": "resourceScheme == file",
          "group": "1_history@2"
        },
        {
          "command": "gitLogWorkbench.editor.compareFileWithRef",
          "when": "resourceScheme == file",
          "group": "2_compare@1"
        }
      ],
      "editor/title": [
        {
          "command": "gitLogWorkbench.diff.jumpToSource",
          "when": "resourceScheme == git-log-workbench",
          "group": "navigation@1"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "gitLogWorkbench.editor.toggleAnnotate",
          "when": "resourceScheme == file || resourceScheme == git-log-workbench",
          "group": "navigation@100"
        },
        {
          "command": "gitLogWorkbench.editor.commitChange",
          "when": "resourceScheme == file",
          "group": "navigation@101"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "gitLogWorkbench",
          "title": "Git Log",
          "icon": "media/git-log.png"
        }
      ],
      "activitybar": [
        {
          "id": "gitLogCommit",
          "title": "Commit",
          "icon": "media/commit.svg"
        }
      ]
    },
    "views": {
      "gitLogWorkbench": [
        {
          "id": "gitLogWorkbench.log",
          "name": "Git Log",
          "type": "webview"
        }
      ],
      "gitLogCommit": [
        {
          "id": "gitLogWorkbench.commit",
          "name": "Commit",
          "type": "webview",
          "icon": "media/commit.svg"
        }
      ]
    },
    "configuration": {
      "title": "Git Log",
      "properties": {
        "gitLogWorkbench.git.path": {
          "type": "string",
          "default": "git",
          "description": "Path to the Git executable."
        },
        "gitLogWorkbench.currentLineBlame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show author, relative time, and commit information after the active editor line. Uncommitted edit times are tracked from document changes and retained in workspace state. Automatically suppressed while VS Code's built-in Git blame editor decoration is enabled."
        },
        "gitLogWorkbench.statusBar.branch.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the current branch of the active file's repository, with commits ahead of and behind its upstream, on the right of the status bar. Click it to open Branches."
        },
        "gitLogWorkbench.lineHistory.contextLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 20,
          "description": "Number of unchanged lines shown above and below changes in current-line history. The tracked Git history remains limited to the current line."
        },
        "gitLogWorkbench.repositories.scanDepth": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 8,
          "description": "Maximum directory depth used when discovering nested repositories."
        },
        "gitLogWorkbench.repositories.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.worktrees/**"
          ],
          "description": "Glob patterns excluded from repository discovery."
        },
        "gitLogWorkbench.log.initialPageSize": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 2000
        },
        "gitLogWorkbench.log.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 20,
          "maximum": 5000
        },
        "gitLogWorkbench.performance.maxCachedCommits": {
          "type": "number",
          "default": 5000,
          "minimum": 200,
          "maximum": 50000
        },
        "gitLogWorkbench.performance.maxDiffFileBytes": {
          "type": "number",
          "default": 5242880,
          "minimum": 1024,
          "maximum": 104857600,
          "description": "Maximum historical file size opened in the built-in text diff editor."
        },
        "gitLogWorkbench.debug.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "debug"
          ],
          "default": "off"
        }
      }
    },
    "keybindings": [
      {
        "command": "gitLogWorkbench.diff.jumpToSource",
        "key": "f4",
        "when": "editorTextFocus && resourceScheme == git-log-workbench"
      },
      {
        "command": "gitLogWorkbench.diff.nextChange",
        "key": "f7",
        "when": "gitLogWorkbench.diffNavigation && textCompareEditorVisible"
      },
      {
        "command": "gitLogWorkbench.diff.previousChange",
        "key": "shift+f7",
        "when": "gitLogWorkbench.diffNavigation && textCompareEditorVisible"
      }
    ]
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "pnpm run build && node ./scripts/run-integration.mjs",
    "test:performance": "vitest run test/performance",
    "test:e2e": "pnpm run build && node test/e2e/run.mjs",
    "package": "pnpm run clean && pnpm run build && vsce package --no-dependencies --baseContentUrl https://github.com/daliuchen/ide-git/blob/main --baseImagesUrl https://raw.githubusercontent.com/daliuchen/ide-git/main"
  },
  "dependencies": {
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "@vscode/codicons": "0.0.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.0.0",
    "playwright-core": "1.55.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
